{
  "$schema": "https://opencode.ai/config.json",
  "model": "local-llama-cpp/${{ kit.args.model }}",
  "plugin": ["opencode-models-discovery@latest"],
  "provider": {
    "local-llama-cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (local)",
      "options": {
        "baseURL": "http://host.docker.internal:${{ kit.args.port }}/v1",
        "modelsDiscovery": {
          "enabled": true
        }
      }
    }
  }
}
